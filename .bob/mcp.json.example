{
  "mcpServers": {
    "bobswarm": {
      "command": "node",
      "args": ["mcp-server/server.js"],
      "cwd": "<ABSOLUTE_PATH_TO_YOUR_LOCAL_CLONE_OF_THIS_REPO>",
      "alwaysAllow": [
        "git_status",
        "git_log",
        "git_diff",
        "git_blame",
        "list_project_files",
        "read_project_file",
        "project_summary",
        "write_swarm_report",
        "record_progress",
        "record_finding",
        "finalize_run",
        "get_run_report"
      ]
    }
  }
}
