# Dependencies
node_modules/
package-lock.json
# Keep each app reproducible even though historical root lockfiles are ignored.
!mcp-server/package-lock.json
!frontend/package-lock.json

# Environment / secrets — never commit these, per hackathon rules on
# credential exposure (IBM Cloud account suspension risk)
.env
.env.local
*.pem
*.key

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
*.log

# Build output
dist/
build/

# Python (demo/ uses Python)
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Bob MCP registration — machine-specific absolute cwd path, one per clone
# location. Commit .bob/mcp.json.example instead; each person copies it and
# fills in their own path (see docs/CRITICAL_DECISIONS.md §5a).
.bob/mcp.json

# Optional local run-state persistence (BOBSWARM_PERSIST_PATH) — real task
# descriptions and evidence text, machine-local only, never committed.
mcp-server/.data/
